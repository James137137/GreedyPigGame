{
  "name": "greedy-pig",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "npm run check && vite build",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "dev": "vite build && wrangler dev --ip 127.0.0.1 --port 8787",
    "dev:ui": "vite",
    "test": "tsx --test tests/game.test.ts",
    "test:integration": "node --test tests/integration.mjs",
    "test:load": "node scripts/simulate.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/space-mono": "^5.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "wrangler": "^4.0.0",
    "ws": "^8.18.0"
  }
}
